# Copy this file to .env and edit. Every setting is optional except DJANGO_SECRET_KEY.

# REQUIRED. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Show detailed error pages and serve files without collectstatic.
# Only enable for local development. Default: false
DJANGO_DEBUG=false

# Hostnames the app may be reached on (comma-separated). Add your machine's
# name or IP if colleagues will open DocuWeaver from other computers.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Required when the app is reached through a hostname other than localhost,
# e.g. http://docuweaver.office.local:8000 or https://docuweaver.example.org
#DJANGO_CSRF_TRUSTED_ORIGINS=http://docuweaver.office.local:8000

# Require users to sign in. Default: true. Set to false for a single-user
# install on a trusted machine (no accounts needed).
DOCUWEAVER_REQUIRE_LOGIN=true

# Directory for the database and uploaded files. Default: the project folder.
#DOCUWEAVER_DATA_DIR=/var/lib/docuweaver

# Enable HTTPS-only cookies, redirects and HSTS. Only turn on once the app is
# actually served over TLS (directly or via a reverse proxy). Default: false
DOCUWEAVER_HTTPS=false

# Largest single upload, in megabytes. Default: 10
#DOCUWEAVER_MAX_UPLOAD_MB=50

# Interface and port for "python manage.py serve". Default: 127.0.0.1:8000
#DOCUWEAVER_HOST=0.0.0.0
#DOCUWEAVER_PORT=8000

# Timezone for timestamps shown in the UI. Default: UTC
#DJANGO_TIME_ZONE=Australia/Brisbane

# Log verbosity: DEBUG, INFO, WARNING, ERROR. Default: INFO
#DOCUWEAVER_LOG_LEVEL=INFO
